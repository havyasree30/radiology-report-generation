{
  "version": "r1-v1",
  "classifier_vocabulary": [
    "No Finding",
    "Enlarged Cardiomediastinum",
    "Cardiomegaly",
    "Lung Opacity",
    "Lung Lesion",
    "Edema",
    "Consolidation",
    "Pneumonia",
    "Atelectasis",
    "Pneumothorax",
    "Pleural Effusion",
    "Pleural Other",
    "Fracture",
    "Support Devices"
  ],
  "normal_term": {
    "normal": "No Finding (only when no abnormal finding is mapped)"
  },
  "no_indexing_term": "No Indexing -> no representation",
  "direct": {
    "Airspace Disease": "Lung Opacity",
    "Cardiomegaly": "Cardiomegaly",
    "Catheters, Indwelling": "Support Devices",
    "Consolidation": "Consolidation",
    "Fractures, Bone": "Fracture",
    "Implanted Medical Device": "Support Devices",
    "Infiltrate": "Lung Opacity",
    "Mass": "Lung Lesion",
    "Medical Device": "Support Devices",
    "Nodule": "Lung Lesion",
    "Opacity": "Lung Opacity",
    "Pleural Effusion": "Pleural Effusion",
    "Pneumonia": "Pneumonia",
    "Pneumothorax": "Pneumothorax",
    "Pulmonary Atelectasis": "Atelectasis",
    "Pulmonary Edema": "Edema",
    "Stents": "Support Devices",
    "Surgical Instruments": "Support Devices",
    "Tube, Inserted": "Support Devices"
  },
  "conditional": [
    {
      "term": "Cardiac Shadow",
      "any_qualifier": [
        "enlarged"
      ],
      "class": "Cardiomegaly",
      "reason": "an enlarged cardiac shadow is cardiomegaly"
    },
    {
      "term": "Thickening",
      "any_qualifier": [
        "pleura"
      ],
      "class": "Pleural Other",
      "reason": "pleural thickening is the classifier's 'Pleural Other' concept"
    }
  ],
  "uncertain": {
    "Pulmonary Congestion": {
      "reason": "vascular congestion is not equivalent to oedema in this vocabulary (the Phase 1 EDA lexicon mapped it to Edema; not adopted here)",
      "occurrences_in_corpus_and_validation": 55
    },
    "Density": {
      "reason": "unspecific radiographic density; may or may not be an opacity",
      "occurrences_in_corpus_and_validation": 115
    },
    "Mediastinum": {
      "reason": "'prominent mediastinum' is not clearly 'enlarged cardiomediastinum'; lymph-node qualifiers are a different finding",
      "occurrences_in_corpus_and_validation": 22
    },
    "Cardiac Shadow": {
      "reason": "mapped to Cardiomegaly only with the qualifier 'enlarged'; other qualifiers (e.g. borderline, prominent) are ambiguous",
      "occurrences_in_corpus_and_validation": 47
    },
    "Thickening": {
      "reason": "mapped to Pleural Other only with the qualifier 'pleura'; other thickening (bronchovascular, lung) is ambiguous",
      "occurrences_in_corpus_and_validation": 50
    }
  },
